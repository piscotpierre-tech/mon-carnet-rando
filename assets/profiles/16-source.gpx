<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<gpx xmlns="http://www.topografix.com/GPX/1/1" version="1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd" creator="Cirkwi"><metadata><name><![CDATA[A pied - L'Abbaye de la Lucerne d'Outremer]]></name><desc><![CDATA[Entre forêt de la Lucerne D'Outremer et vallée du Thar, puisez votre énergie d'arbre en arbre jusqu'à l'if remarquable. Retrouvez sérénité au cœur de cette nature et de ce site monastique restauré qui a passé les siècles.]]></desc><author><name><![CDATA[OT Granville Terre et Mer]]></name></author><link href="http://fichier0.cirkwi.com/image/photo/circuit/1300x1300/172446/fr/0.jpg"></link></metadata><wpt lat="48.7922206" lon="-1.4674687"><name><![CDATA[Face à l'entrée de l'abbaye,]]></name><desc><![CDATA[suivez la D105 à gauche. Traversez le pont du Thar et prenez à droite le large chemin entre forêt et rivière sur 300 m.]]></desc></wpt><wpt lat="48.79358" lon="-1.46388"><name><![CDATA[Arrivez devant le ruisseau sans le franchir]]></name><desc><![CDATA[et empruntez le chemin à gauche, suivez-le : vous croisez un moulin en cours de restauration. Depuis l'extérieur, on peut apercevoir les meules en pierre servant à moudre le grain comme autrefois. Cheminez et traversez le passerelle à droite, puis tournez à gauche.]]></desc></wpt><wpt lat="48.8029028" lon="-1.4478672"><name><![CDATA[Près du calvaire, empruntez la D309 à droite]]></name><desc><![CDATA[et traversez Saint-Ursin. Passez près de l'if millénaire et continuez sur la D309, sur 500 m.]]></desc></wpt><wpt lat="48.8006662" lon="-1.4341557"><name><![CDATA[Tournez à droite vers la Gisardière.]]></name><desc><![CDATA[A l'entrée du hameau, prenez à gauche le chemin qui descend au Thar et franchissez-le.]]></desc></wpt><wpt lat="48.79578" lon="-1.43078"><name><![CDATA[A la croisée des chemins, suivez celui de droite.]]></name><desc><![CDATA[Il monte dans la forêt et aboutit à une intersection de sept chemins.]]></desc></wpt><wpt lat="48.79164" lon="-1.43765"><name><![CDATA[Suivez à droite une large allée forestière,]]></name><desc><![CDATA[sur 1,8 km (peu de balisage). La forêt est privée, veillez à ne pas vous écartez du chemin. Quittez la forêt.]]></desc></wpt><wpt lat="48.7900153" lon="-1.4623833"><name><![CDATA[Dirigez-vous à droite]]></name><desc><![CDATA[pour rejoindre la D105 et empruntez-la sur votre droite.]]></desc></wpt><wpt lat="48.7903121" lon="-1.4682627"><name><![CDATA[Au carrefour routier,]]></name><desc><![CDATA[continuez en face par la D105 pour rejoindre l'Abbaye de la Lucerne d'Outremer.]]></desc></wpt><trk><trkseg><trkpt lat="48.7917" lon="-1.46791"></trkpt><trkpt lat="48.79222" lon="-1.46747"></trkpt><trkpt lat="48.79356" lon="-1.46762"></trkpt><trkpt lat="48.79348" lon="-1.46618"></trkpt><trkpt lat="48.79331" lon="-1.46439"></trkpt><trkpt lat="48.79358" lon="-1.46388"></trkpt><trkpt lat="48.7939" lon="-1.46388"></trkpt><trkpt lat="48.79414" lon="-1.46376"></trkpt><trkpt lat="48.79448" lon="-1.46371"></trkpt><trkpt lat="48.79474" lon="-1.46349"></trkpt><trkpt lat="48.79474" lon="-1.46315"></trkpt><trkpt lat="48.79491" lon="-1.46231"></trkpt><trkpt lat="48.79513" lon="-1.4619"></trkpt><trkpt lat="48.79545" lon="-1.46173"></trkpt><trkpt lat="48.79593" lon="-1.46102"></trkpt><trkpt lat="48.79594" lon="-1.46073"></trkpt><trkpt lat="48.79587" lon="-1.46055"></trkpt><trkpt lat="48.79628" lon="-1.45992"></trkpt><trkpt lat="48.79677" lon="-1.45855"></trkpt><trkpt lat="48.7971" lon="-1.458"></trkpt><trkpt lat="48.79743" lon="-1.45744"></trkpt><trkpt lat="48.79785" lon="-1.45649"></trkpt><trkpt lat="48.79807" lon="-1.45605"></trkpt><trkpt lat="48.79818" lon="-1.45589"></trkpt><trkpt lat="48.7983" lon="-1.45577"></trkpt><trkpt lat="48.79894" lon="-1.4552"></trkpt><trkpt lat="48.79925" lon="-1.45483"></trkpt><trkpt lat="48.79951" lon="-1.45463"></trkpt><trkpt lat="48.80004" lon="-1.45442"></trkpt><trkpt lat="48.8003" lon="-1.45426"></trkpt><trkpt lat="48