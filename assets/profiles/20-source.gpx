<gpx xmlns="http://www.topografix.com/GPX/1/1" version="1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd" creator="Cirkwi"><metadata><name><![CDATA[A pied - Le Havre de la Vanlée]]></name><desc><![CDATA[Point de départ conseillé : Parking à l’intersection de la Route du Havre de la Vanlée et la Route des Salines, Bricqueville-sur-Mer.  Cette randonnée 100 % nature vous permet de sillonner le Havre de la Vanlée, véritable lien entre la terre et la mer, prisé par les limicoles hivernants. Écoutez le chant de l’Huîtrier-pie, du Pluvier argenté ou encore du Courlis cendré, qui trouvent dans les vasières de quoi se nourrir et se réfugier.]]></desc><author><name><![CDATA[OT Granville Terre et Mer]]></name></author><link href="http://fichier0.cirkwi.com/image/photo/circuit/1300x1300/300063/fr/0.jpg"></link></metadata><trk><trkseg><trkpt lat="48.91477" lon="-1.54767"></trkpt><trkpt lat="48.91489" lon="-1.54878"></trkpt><trkpt lat="48.915" lon="-1.55231"></trkpt><trkpt lat="48.9152" lon="-1.55841"></trkpt><trkpt lat="48.91523" lon="-1.56047"></trkpt><trkpt lat="48.91512" lon="-1.56098"></trkpt><trkpt lat="48.91433" lon="-1.56107"></trkpt><trkpt lat="48.91238" lon="-1.56034"></trkpt><trkpt lat="48.91176" lon="-1.56008"></trkpt><trkpt lat="48.91128" lon="-1.55987"></trkpt><trkpt lat="48.90939" lon="-1.55985"></trkpt><trkpt lat="48.90833" lon="-1.56004"></trkpt><trkpt lat="48.90824" lon="-1.55945"></trkpt><trkpt lat="48.90462" lon="-1.56048"></trkpt><trkpt lat="48.90424" lon="-1.55767"></trkpt><trkpt lat="48.90358" lon="-1.55752"></trkpt><trkpt lat="48.90276" lon="-1.55731"></trkpt><trkpt lat="48.90224" lon="-1.55731"></trkpt><trkpt lat="48.90157" lon="-1.5572"></trkpt><trkpt lat="48.90153" lon="-1.55712"></trkpt><trkpt lat="48.90144" lon="-1.55629"></trkpt><trkpt lat="48.90144" lon="-1.55599"></trkpt><trkpt lat="48.90141" lon="-1.55573"></trkpt><trkpt lat="48.90139" lon="-